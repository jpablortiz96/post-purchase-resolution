# ── Post-Purchase Resolution — environment ──────────────────────────
#
# Copy to `.env` and fill in. NEVER commit `.env` — it is gitignored.
#
# In production these belong in Vercel environment variables
# (`vercel env add`), so no credential ever reaches browser JavaScript.
# Everything below is read only inside `api/` serverless functions.
#
# Setup walkthrough: docs/SHOPIFY_SETUP.md
#
# Note: values containing `#` must be quoted. Node's --env-file treats an
# unquoted `#` as the start of a comment, which silently truncates the value.


# ══ REQUIRED — Shopify connection ═══════════════════════════════════

# Your development store. Either form works; ".myshopify.com" is appended
# when the value has no dot.
#   e.g. my-dev-store          or   my-dev-store.myshopify.com
SHOPIFY_SHOP=

# From the Shopify app you create for this project (Dev Dashboard → your app).
# The client ID is public; the secret is NOT and must stay server-side.
# Used for Admin API access via the client_credentials grant.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=


# ══ REQUIRED — customer session sealing ═════════════════════════════

# Key used to seal the OAuth transaction and customer session cookies
# (AES-256-GCM). Must be at least 32 characters of high-entropy random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every customer out. It is not a Shopify value.
SESSION_SECRET=


# ══ REQUIRED — merchant desk access ═════════════════════════════════

# High-entropy shared credential that gates the merchant decision desk:
# the return queue and every approval. Compared in constant time,
# server-side. This is a stopgap that prevents anonymous approval — it is
# NOT merchant identity. Generate as above.
MERCHANT_OPERATOR_TOKEN=


# ══ OPTIONAL — pinned versions and URLs ═════════════════════════════

# Stable Admin + Customer Account API version. Do not use "unstable".
# Defaults to 2026-07 when unset.
SHOPIFY_API_VERSION=2026-07

# Customer Account OAuth callback. Must EXACTLY match the redirect URI
# registered in shopify.app.toml under [customer_authentication].
# Defaults to the deployed production URL when unset.
SHOPIFY_CUSTOMER_REDIRECT_URI=https://your-domain.example/api/auth/callback

# Where Shopify returns the customer after RP-initiated sign-out. Must be a
# registered logout_url. Defaults to the deployed production origin.
SHOPIFY_POST_LOGOUT_REDIRECT_URI=https://your-domain.example


# ══ OPTIONAL — signed-out fallback ══════════════════════════════════

# The order shown to a SIGNED-OUT visitor, via the Admin API. This is the
# only place the product names an order; the authenticated customer path
# discovers purchases through the Customer Account API and names none.
# Callers cannot select an order — the first entry is the only one served.
# QUOTE THIS: order names begin with "#".
SHOPIFY_DEMO_ORDER_NAMES="#1002,#1001"


# ══ OPTIONAL — safety switch ════════════════════════════════════════

# Set to "false" to make the deployment strictly read-only: every commerce
# mutation is refused with MUTATIONS_DISABLED. Anything else (or unset)
# leaves mutations enabled.
COMMERCE_MUTATIONS_ENABLED=true


# ══ DEVELOPMENT / HARNESS ONLY ══════════════════════════════════════
# Not read by the application. Used by scripts under harness/.

# Local server port for `npm start`. Defaults to 3000.
# PORT=3000

# Target for the live verification harnesses. Defaults to localhost.
# APP_URL=https://your-domain.example/

# Where harness runs write their output. Defaults to evidence/_latest,
# never a milestone directory — a re-run must not overwrite history.
# OUT_DIR=evidence/_latest

# Chrome/Chromium binary for the puppeteer-driven WebMCP suites.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
