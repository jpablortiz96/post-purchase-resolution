# Shopify development-store credentials for the M4.1 real-commerce spike.
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# In production these belong in Vercel environment variables (`vercel env add`)
# so the token stays server-side and never reaches browser JavaScript.
#
# See docs/SHOPIFY_PREFLIGHT.md for how to obtain each value.

# Your development store, e.g. my-dev-store.myshopify.com
SHOPIFY_SHOP_DOMAIN=

# Admin API access token from a custom app installed on the development store.
# Shown once at install. Scopes needed: read_orders, read_returns, write_returns
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Pinned stable API version. Do not use "unstable" or a release candidate.
SHOPIFY_API_VERSION=2026-07

# The single seeded demo order the public demo is allowed to touch.
# Must have a FULFILLED line item or there is nothing returnable.
# Global ID form, e.g. gid://shopify/Order/1234567890
SHOPIFY_DEMO_ORDER_ID=
